{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "usage: 增量抓取",
      "type": "shell",
      "command": "make usage",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "serve: 本地服务 :18080",
      "type": "shell",
      "command": "fuser -k 18080/tcp 2>/dev/null; lsof -ti:18080 2>/dev/null | xargs -r kill -9 2>/dev/null; pkill -9 server 2>/dev/null; sleep 1; make serve",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "stats: 生成 export/*.md",
      "type": "shell",
      "command": "make stats",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "site: 生成 docs/index.html",
      "type": "shell",
      "command": "make site",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "build: 编译 bin/*",
      "type": "shell",
      "command": "make build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$go"
    },
    {
      "label": "vet",
      "type": "shell",
      "command": "make vet",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$go"
    }
  ]
}
